APP_NAME=LaraClaw
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laraclaw
DB_USERNAME=root
DB_PASSWORD=

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_API_KEY=
# Optional JSON object of extra headers for remote Ollama-compatible backends
# Example: OLLAMA_HEADERS={"X-Forwarded-Token":"secret"}
OLLAMA_HEADERS=[]
OLLAMA_AGENT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_LENGTH=8192

# Dev tooling: directory of the Hermes3D Studio checkout that `composer run dev`
# also launches (defaults to ~/projects/Hermes3D). Read from the shell environment,
# not from this file — export it in your shell to override.
HERMES3D_DIR=

# Working directory for agent operations (persistent; avoid /tmp for files you want to keep)
AGENT_WORKING_DIR=${HOME}/.laraclaw/working
# Paths the agent is allowed to operate in
AGENT_ALLOWED_PATHS=${HOME}/.laraclaw,${AGENT_WORKING_DIR},${HOME}/projects,${HOME},${PWD}
# Plain-text .env that holds social/API credentials (INSTAGRAM_*, FACEBOOK_*, YOUTUBE_*, etc.)
# The social tools read tokens from this file when none are passed in.
# Keep this outside /tmp so it persists across reboots/sessions.
AGENT_CREDENTIALS_FILE=${HOME}/.laraclaw/.env
# Social-media media library root. Subfolders: "CLIPPED MEDIA", "INSTAGRAM", "YOUTUBE", "FACEBOOK".
AGENT_MEDIA_ROOT=${HOME}/laraclaw-media
# Per-clip ffmpeg execution budget, in seconds.
AGENT_MEDIA_CLIP_TIMEOUT=900
AGENT_ENABLE_MEDIA_CLIP=true
AGENT_SHELL_TIMEOUT=30
# Max seconds a single OpenCode agent run may take (see AGENT_TASK_STEP_TIMEOUT).
AGENT_OPENCODE_TIMEOUT=3600
AGENT_MAX_FILE_SIZE_MB=10
AGENT_MAX_OUTPUT_LINES=500
AGENT_ENABLE_SHELL=true
AGENT_ENABLE_WEB=true

# Task engine model routing (defaults to OLLAMA_AGENT_MODEL when unset)
SIMPLE_TASK_MODEL=
CODING_TASK_MODEL=
REASONING_TASK_MODEL=
REVIEW_TASK_MODEL=
COMPLEX_TASK_MODEL=

# Task engine tuning
AGENT_TASK_HEARTBEAT_SECONDS=90
AGENT_TASK_STALE_GRACE=120
AGENT_TASK_MAX_ATTEMPTS=5
AGENT_TASK_MAX_STEP_ATTEMPTS=3
AGENT_TASK_MAX_AUTO_RECOVERIES=3
AGENT_TASK_LOOP_THRESHOLD=4
# Max seconds a single task step may run (job timeout + lock TTL + step lease).
# Keep it above AGENT_OPENCODE_TIMEOUT so long agent turns are not killed.
AGENT_TASK_STEP_TIMEOUT=3600
AGENT_TASK_VERIFICATION_REQUIRED=true
AGENT_TASK_PLANNING_ENABLED=true
AGENT_TASK_QUEUE=tasks

BRAVE_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_MAX_RESULTS=5

# Facebook Graph API (tool: facebook)
# Credentials (access_token, page_id) are supplied by the agent from memory — no env vars needed.
FACEBOOK_GRAPH_URL=https://graph.facebook.com/v21.0
AGENT_ENABLE_FACEBOOK=true

# Instagram Graph API (tool: instagram)
# Credentials (access_token, account_id) are supplied by the agent from memory — no env vars needed.
INSTAGRAM_GRAPH_URL=https://graph.facebook.com/v21.0
AGENT_ENABLE_INSTAGRAM=true

# YouTube Data API v3 (tool: youtube)
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud and enable the
# "YouTube Data API v3". Set the client id/secret and a redirect URI you control.
# Run the one-time consent flow (tool action=auth_url, then action=exchange_code) and
# store the returned refresh token. The refresh token can live here or be passed per call.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=
YOUTUBE_UPLOAD_TIMEOUT=1800
AGENT_ENABLE_YOUTUBE=true

# WhatsApp via OpenWA / Wazuri gateway (tool: whatsapp)
# The gateway runs locally (Docker: wazuri-api) at http://127.0.0.1:2785/api and
# authenticates with an X-API-Key header. Create an operator/admin key in the
# gateway dashboard and a session, then set these (or omit them and let the agent
# pass api_key/session_id per call, or read them from AGENT_CREDENTIALS_FILE:
# OPENWA_API_KEY, OPENWA_SESSION_ID, OPENWA_BASE_URL).
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
AGENT_ENABLE_WHATSAPP=true

# Docker (tool: docker)
# Talks to the local Docker daemon over the Unix socket by default.
# For a remote host, set DOCKER_HOST, e.g. tcp://10.0.0.5:2376 with TLS configured on the daemon.
DOCKER_BINARY=docker
DOCKER_HOST=
DOCKER_TIMEOUT=60
AGENT_ENABLE_DOCKER=true

# Cloudflare API (tool: cloudflare)
# Credentials (api_token, account_id) are supplied by the agent from memory — no env vars needed.
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
AGENT_ENABLE_CLOUDFLARE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
